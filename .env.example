# ============================================================
#  Itanhaém Prev — variáveis de ambiente (copie para .env)
# ============================================================

# Banco PostgreSQL (produção). Sem esta variável o sistema usa um
# banco embutido local em ./.data (apenas para desenvolvimento).
DATABASE_URL=postgres://itaprev:SENHA_FORTE@localhost:5432/itaprev

# Segredo para assinar as sessões do painel. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Usuário administrador criado pelo "npm run db:seed"
# (se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e exibida uma vez)
ADMIN_EMAIL=admin@itanhaemprev.sp.gov.br
ADMIN_PASSWORD=

# Pasta onde ficam os arquivos enviados pelo painel (PDFs, imagens).
# Precisa ser persistente e entrar no backup.
UPLOAD_DIR=/var/www/itaprev-uploads

# Endereço público do site (usado em links absolutos)
SITE_URL=https://www.itanhaemprev.sp.gov.br

# Chatbot (fluxo n8n). Chamado só pelo servidor (rota /api/chat).
# (NEXT_PUBLIC_CHATBOT_WEBHOOK, nome antigo, continua aceito.)
CHATBOT_WEBHOOK=https://n8n.triusbot.site/webhook/itaprev-chat

# --- Opcionais (têm valor padrão; normalmente não precisa mexer) ---
# Backups (scripts/backup.sh e os feitos antes de atualizar/migrar). Padrão: ./backups
# BACKUP_DIR=/var/backups/itaprev
# Dias que cada backup é mantido. Padrão: 30
# BACKUP_RETENTION_DAYS=30
# Cópia de cada backup em outro disco/servidor (recomendado)
# BACKUP_COPY_DIR=/mnt/backup-externo/itaprev
#
# Site WordPress de origem para o "npm run db:import-wp".
# Padrão: o próprio site oficial (https://www.itanhaemprev.sp.gov.br)
# WP_URL=https://www.itanhaemprev.sp.gov.br
#
# Pasta do banco embutido PGlite (só em desenvolvimento, sem DATABASE_URL).
# Padrão: ./.data/pglite
# PGLITE_DIR=./.data/pglite
#
# Cópia de testes (homologação): faixa de aviso no topo e fora do Google. Ver DEPLOY.md.
# HOMOLOGACAO=1
